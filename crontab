# Algo Trading Crontab (v2)
# Install with: crontab /home/jay/dev/algo/crontab
# All times are MST (America/Denver, UTC-7)

PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin

# Paper trading session (12:30 PM MST / 2:30 PM ET, Mon-Fri)
30 12 * * 1-5 cd /home/jay/dev/algo/ && task paper:session

# Daily session (1 PM MST / 3 PM ET, Mon-Fri)
# Stage 0: backfill outcomes + compute attribution + build constraints
# Stage 1: news pipeline (fetch, Haiku classify, store)
# Stage 2: Claude Opus strategist (thesis management, playbook generation)
# Stage 3: Claude Haiku executor (validate, execute, log)
# Stage 4: strategy reflection (memo, identity, rule proposals)
# Stage 5: dashboard publish
0 13 * * 1-5 /home/jay/dev/algo/run-docker.sh trading python -m v2.session

# Weekly deep learning analysis (5 AM MST / 7 AM ET, Sunday)
0 5 * * 0 /home/jay/dev/algo/run-docker.sh trading python -m v2.learn --days 60
