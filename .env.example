# Alpaca API (use paper trading first)
ALPACA_API_KEY=your_api_key
ALPACA_SECRET_KEY=your_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Required: true for paper, false for live. Cross-checked against ALPACA_BASE_URL
# at module load — mismatched values raise immediately.
ALPACA_PAPER=true

# Finnhub API (for market data - free tier)
FINNHUB_API_KEY=your_finnhub_api_key

# Claude API (for ideation)
ANTHROPIC_API_KEY=your_secret_key

# Database
POSTGRES_USER=algo
POSTGRES_PASSWORD=algo
POSTGRES_DB=trading
DATABASE_URL=postgresql://algo:algo@db:5432/trading

# --- Operational knobs (optional) ---
# Kill switch: set to 1/true/yes to make every session a no-op (logs + exits 0).
# Read at session start, so it takes effect on the next run with no container
# restart. Host-side twin: `touch HALT` in the repo root, which stops the cron
# wrapper before it even starts containers. See docs/runbook-recovery.md.
# ALGO_TRADING_HALTED=

# Daily-loss circuit breaker, % vs previous close (default 3.0; <= 0 disables).
# ALGO_DAILY_LOSS_LIMIT_PCT=3.0

# Per-agentic-loop cost ceiling in USD (default 30; <= 0 disables).
# ALGO_LOOP_COST_CEILING_USD=30

# Executor model / token cap overrides (read at import — restart to apply).
# ALGO_EXECUTOR_MODEL=claude-haiku-4-5-20251001
# ALGO_EXECUTOR_MAX_TOKENS=8192

# NOTE: ALGO_ALERT_WEBHOOK_URL, ALGO_HEARTBEAT_URL* and ALGO_BACKUP_COPY_DIR are
# read by host-side scripts (cron-wrap.sh, task db:backup) — env_file only feeds
# containers, so setting them here has NO effect. They live in .env.host; copy
# .env.host.example to get started.

# Cloudflare Pages (public dashboard)
# Create project: Cloudflare dashboard → Pages → Create → Direct Upload
# Create token: My Profile → API Tokens → Cloudflare Pages: Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=your-project-name
DASHBOARD_URL=https://your-project.pages.dev
